# Exporte as variáveis no processo ou use EnvironmentFile no serviço.
# .env não é carregado implicitamente por python app.py.
SECRET_KEY=
GETPING_ENV=production
GETPING_DATABASE=/caminho/absoluto/GetPing_eth_admin/database/db_getping.db
# Ative somente após verificar fingerprints no cliente e vínculos existentes.
GETPING_REQUIRE_FINGERPRINT=0
# 1 somente atrás de um proxy confiável, sem acesso direto ao backend.
GETPING_PROXY_HOPS=0
# Chaves de 128 bits somente após verificar o formato aceito pelo cliente.
GETPING_EXTENDED_KEYS=0
