# Configure server_name e certificados reais antes de instalar.
server {
    listen 80;
    server_name admin.exemplo.com;
    return 301 https://$host$request_uri;
}
server {
    listen 443 ssl;
    server_name admin.exemplo.com;
    ssl_certificate /etc/letsencrypt/live/admin.exemplo.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/admin.exemplo.com/privkey.pem;
    client_max_body_size 32k;
    location / {
        proxy_pass http://127.0.0.1:5001;
        proxy_set_header Host $host;
        # Sobrescreve o valor recebido do cliente, em vez de confiar nele.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
