[Unit]
Description=GetPing Admin
After=network.target

[Service]
# Substitua usuário e caminhos antes de instalar.
User=getping
Group=getping
WorkingDirectory=/opt/getping-admin
EnvironmentFile=/etc/getping-admin.env
ExecStart=/opt/getping-admin/venv/bin/gunicorn -c deploy/gunicorn.conf.py 'getping_admin:create_app()'
Restart=on-failure
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
# Use o diretório de GETPING_DATABASE; mantenha /database para banco legado.
ReadWritePaths=/opt/getping-admin/instance

[Install]
WantedBy=multi-user.target
